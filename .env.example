# --- Public address --------------------------------------------------------
# The hostname Caddy obtains a certificate for (docker-compose only).
TERRASYNC_DOMAIN=terrasync.example.com
# The externally visible origin; used in alert links and to enable HSTS.
TERRASYNC_PUBLIC_BASE_URL=https://terrasync.example.com

# --- First administrator (created on start if the address is new) -----------
TERRASYNC_ADMIN_ORG=Sensegrass
TERRASYNC_ADMIN_EMAIL=
TERRASYNC_ADMIN_PASSWORD=

# --- Access -----------------------------------------------------------------
# Self-service sign-up. Off unless you want anyone who reaches the site to be
# able to create an organisation.
TERRASYNC_ALLOW_SIGNUP=0
# Sign-in/sign-up attempts per client address per window.
TERRASYNC_AUTH_RATE_LIMIT=10
TERRASYNC_AUTH_RATE_WINDOW_S=300
# Only if the web app is hosted on another origin, comma-separated.
TERRASYNC_CORS_ORIGINS=

# --- Imagery (engine settings; see TerraSync README "Imagery providers") -----
# earth-search | planetary-computer | cdse | sentinel-hub | planet | maxar |
# umbra | synthetic
TERRASHIELD_PROVIDER=earth-search
# TERRASHIELD_PLANET_API_KEY=

# --- Monitoring schedule ------------------------------------------------------
# How often to look for newly published imagery (seconds). Each look is one
# catalogue search per area; new scenes are analysed and alerted in that cycle.
TERRASYNC_WORKER_INTERVAL_S=3600
TERRASYNC_BACKFILL_DAYS=14
TERRASYNC_SETTLE_DAYS=0
# A scene published up to this many days late still gets its day re-analysed.
TERRASYNC_RECHECK_DAYS=3
TERRASYNC_MAX_DAYS_PER_CYCLE=7
# Run the worker inside the API process (single-container hosts).
TERRASYNC_EMBEDDED_WORKER=0

# --- Alert delivery -------------------------------------------------------------
# Email destinations need a relay. Port 465 uses implicit TLS; others STARTTLS.
TERRASYNC_SMTP_HOST=
TERRASYNC_SMTP_PORT=587
TERRASYNC_SMTP_USERNAME=
TERRASYNC_SMTP_PASSWORD=
TERRASYNC_SMTP_FROM=
# Allow webhook receivers on private addresses (on-premise only).
TERRASYNC_WEBHOOK_ALLOW_PRIVATE=0
